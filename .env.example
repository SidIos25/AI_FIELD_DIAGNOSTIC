# Copy this file to .env and fill in safe local values only.
# Never commit a real secret to the repository.

OPENAI_KEY=replace_with_openai_key
DIAGNOSTIC_API_KEY=replace_with_diagnostic_api_key
DIAGNOSTIC_TIMEOUT_SECONDS=20
DIAGNOSTIC_RATE_LIMIT_WINDOW_SECONDS=60
DIAGNOSTIC_RATE_LIMIT_MAX_REQUESTS=30
RAG_DATA_DIR=./rag_store
